PORT=4000
DATABASE_URL=postgres://postgres@127.0.0.1:5433/wayground
JWT_SECRET=change-me-wayground-clone-secret
# OpenAI-compatible endpoint serving the multimodal Gemma model
# (Ollama: http://127.0.0.1:11434/v1, LM Studio: http://127.0.0.1:1234/v1, llama.cpp server: http://127.0.0.1:8080/v1)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemma4
LLM_API_KEY=
CLIENT_ORIGIN=http://localhost:5173
# Reading test: how many times the AI re-checks each cropped figure (0-5)
CROP_REVIEW_ROUNDS=3
